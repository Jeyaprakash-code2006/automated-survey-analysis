APP_NAME=Automated Survey Analysis
APP_ENV=development
DEBUG=True

API_HOST=127.0.0.1
API_PORT=8000

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256

DATABASE_URL=sqlite:///./survey_analysis.db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

MAX_FILE_SIZE_MB=250
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs

DEFAULT_NPS_COLUMN=NPS
DEFAULT_CSAT_COLUMN=CSAT
DEFAULT_CES_COLUMN=CES
DEFAULT_TEXT_COLUMN=Response

SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

BERTOPIC_MIN_TOPIC_SIZE=10
BERTOPIC_MAX_DOCUMENTS=5000

LOG_LEVEL=INFO